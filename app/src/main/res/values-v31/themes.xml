<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Flixcomix" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/orange</item>
        <item name="colorPrimaryVariant">@color/white</item>
        <item name="background">@color/white</item>
        <item name="android:windowBackground">@color/white</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/white</item>
        <item name="colorSecondaryVariant">@color/white</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->

        <item name="android:windowSplashScreenBackground">?attr/background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>

        <item name="color_background">@color/white</item>
        <item name="color_background_second">@color/gray_100</item>
        <item name="color_background_third">@color/white</item>
        <item name="color_background_div">@color/gray_200</item>

        <item name="color_primary_orange">@color/orange</item>
        <item name="color_disable_orange">@color/orange_status</item>
        <item name="color_background_button">@color/gray_700</item>
        <item name="color_background_button_status">@color/gray_400</item>

        <item name="text_color_gray_subtitle">@color/gray_800</item>
        <item name="text_color_span">@color/gray_700</item>
        <item name="text_color_span_700_300">@color/gray_700</item>
        <item name="text_color_span_500">@color/gray_500</item>
        <item name="text_color_head_1">@color/gray_900</item>
        <item name="text_color_head_2">@color/gray_800</item>
        <item name="text_color_primary_orange">@color/orange</item>
        <item name="text_color_primary_white">@color/white</item>
        <item name="color_indicator">@color/gray_200</item>
    </style>
</resources>