<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="viewModel"
            type="com.hin.movie.ui.sign_up.SignUpViewModel" />
    </data>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".ui.sign_up.SignUpFragment">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingVertical="30dp">

                <ImageView
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_gravity="center"
                    android:layout_marginTop="40dp"
                    android:contentDescription="@string/logo"
                    android:src="@drawable/logo" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginVertical="40dp"
                    android:fontFamily="@font/urbanist_bold"
                    android:text="@string/create_your_account"
                    android:textColor="?attr/text_color_head_1"
                    android:textSize="32dp"
                    tools:ignore="SpUsage" />

                <EditText
                    android:id="@+id/editTxtEmail"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginHorizontal="24dp"
                    android:autofillHints="emailAddress"
                    android:background="@drawable/selector_edit_text_bg"
                    android:drawableStart="@drawable/email_bold"
                    android:drawablePadding="12dp"
                    android:drawableTint="@color/selector_color_edit_text"
                    android:fontFamily="@font/urbanist_semibold"
                    android:hint="@string/email"
                    android:inputType="textEmailAddress"
                    android:paddingHorizontal="20dp"
                    android:textColorHint="@color/gray_500"
                    android:textSize="14dp"
                    tools:ignore="SpUsage" />

                <com.hin.movie.ui.custom.edit_text.PasswordInputView
                    android:id="@+id/editTxtPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="24dp"
                    android:layout_marginTop="20dp" />

                <com.hin.movie.ui.custom.edit_text.PasswordInputView
                    android:id="@+id/editTxtConfirmPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="24dp"
                    android:layout_marginTop="20dp" />


                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSignUp"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginHorizontal="24dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/button_bg"
                    android:enabled="false"
                    android:fontFamily="@font/urbanist_bold"
                    android:stateListAnimator="@null"
                    android:text="@string/sign_up"
                    android:textAllCaps="false"
                    app:backgroundTint="@null"
                    android:textColor="@color/white" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="24dp"
                    android:layout_marginTop="40dp"
                    android:layout_marginBottom="20dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="?attr/color_background_div" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        android:fontFamily="@font/urbanist_semibold"
                        android:text="@string/or_continue_with"
                        android:textColor="?attr/text_color_span"
                        android:textSize="18dp"
                        tools:ignore="SpUsage" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="?attr/color_background_div" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="24dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/btnSignWithFacebook"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/color_button_bg_dark"
                        android:contentDescription="@string/continue_with_facebook"
                        android:paddingHorizontal="32dp"
                        android:paddingVertical="18dp"
                        android:src="@drawable/fb" />

                    <ImageButton
                        android:id="@+id/btnSignWithGoogle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="20dp"
                        android:background="@drawable/color_button_bg_dark"
                        android:contentDescription="@string/continue_with_google"
                        android:paddingHorizontal="32dp"
                        android:paddingVertical="18dp"
                        android:src="@drawable/gg" />

                    <ImageButton
                        android:id="@+id/btnSignWithApple"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/color_button_bg_dark"
                        android:contentDescription="@string/continue_with_apple"
                        android:paddingHorizontal="32dp"
                        android:paddingVertical="18dp"
                        android:src="@drawable/apple" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="24dp"
                    android:layout_marginTop="40dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/urbanist"
                        android:text="@string/already_have_an_account"
                        android:textColor="?attr/text_color_span_500"
                        android:textSize="14dp"
                        tools:ignore="SpUsage" />

                    <TextView
                        android:id="@+id/txtToSignIn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="@font/urbanist_semibold"
                        android:text="@string/sign_in"
                        android:textColor="@color/orange"
                        android:textSize="14dp"
                        tools:ignore="SpUsage" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <FrameLayout
            android:id="@+id/frameLayoutLoading"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/gray_600_70"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:visibility="gone">

            <com.hin.movie.ui.custom.image_view.SpinImageView
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_gravity="center"
                android:contentDescription="@string/spin"
                android:src="@drawable/spin" />
        </FrameLayout>
    </FrameLayout>
</layout>