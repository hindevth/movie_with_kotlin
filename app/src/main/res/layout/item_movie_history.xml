<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable name="imageUrl" type="String" />
        <variable name="name" type="String" />
        <variable name="currentEpisode" type="String" />
        <variable name="currentTime" type="String" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <androidx.cardview.widget.CardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            app:cardCornerRadius="10dp">

            <ImageView
                android:id="@+id/imageMovie"
                android:layout_width="150dp"
                android:layout_height="112dp"
                android:scaleType="centerCrop"
                app:imageUrl="@{imageUrl}"
                android:contentDescription="@string/image_movie" />
        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="110dp"
            android:layout_margin="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/text_18_700"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="@{name}"
                android:textColor="?attr/text_color_head_1" />

            <TextView
                style="@style/text_14_600"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:text='@{@string/watching + " " + currentEpisode}'
                android:textColor="?attr/text_color_head_2" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <androidx.cardview.widget.CardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:layout_marginBottom="2dp"
                    app:cardCornerRadius="6dp"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentBottom="true">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@{currentTime}"
                        android:background="@color/orange_8"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="6dp"
                        android:textColor="@color/orange"
                        style="@style/text_10_600" />
                </androidx.cardview.widget.CardView>
                <ImageButton
                    android:id="@+id/btnDelete"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/delete"
                    android:background="@null"
                    android:layout_margin="5dp"
                    android:layout_gravity="end"
                    app:tint="@color/status_error"
                    android:layout_alignParentBottom="true"
                    android:layout_alignParentEnd="true"
                    android:contentDescription="@string/delete" />
            </RelativeLayout>
        </LinearLayout>
    </LinearLayout>
</layout>