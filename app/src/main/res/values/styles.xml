<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools" xmlns:app="http://schemas.android.com/apk/res-auto">
    <style name="styleFilterChecked">
        <item name="android:textColor">@color/white</item>
        <item name="android:background">@drawable/button_bg</item>
    </style>
    <style name="styleFilterUnCheck">
        <item name="android:textColor">@color/orange</item>
        <item name="android:background">@drawable/color_outline_orange</item>
    </style>

    <style name="TabLayoutTextAppearance" parent="TextAppearance.Design.Tab">
        <item name="textAllCaps">false</item>
    </style>

    <style name="text_12_500">
        <item name="android:textSize" tools:ignore="SpUsage">12dp</item>
        <item name="android:fontFamily">@font/urbanist_medium</item>
    </style>

    <style name="text_10_600">
        <item name="android:textSize" tools:ignore="SpUsage">10dp</item>
        <item name="android:fontFamily">@font/urbanist_semibold</item>
    </style>

    <style name="text_14_400">
        <item name="android:textSize" tools:ignore="SpUsage">14dp</item>
        <item name="android:fontFamily">@font/urbanist</item>
    </style>

    <style name="text_14_600">
        <item name="android:textSize" tools:ignore="SpUsage">14dp</item>
        <item name="android:fontFamily">@font/urbanist_semibold</item>
    </style>

    <style name="text_16_600">
        <item name="android:textSize" tools:ignore="SpUsage">16dp</item>
        <item name="android:fontFamily">@font/urbanist_semibold</item>
    </style>

    <style name="text_16_700">
        <item name="android:textSize" tools:ignore="SpUsage">16dp</item>
        <item name="android:fontFamily">@font/urbanist_bold</item>
    </style>

    <style name="text_18_700">
        <item name="android:textSize" tools:ignore="SpUsage">18dp</item>
        <item name="android:fontFamily">@font/urbanist_bold</item>
    </style>

    <style name="text_20_700">
        <item name="android:textSize" tools:ignore="SpUsage">20dp</item>
        <item name="android:fontFamily">@font/urbanist_bold</item>
    </style>

    <style name="text_24_700">
        <item name="android:textSize" tools:ignore="SpUsage">24dp</item>
        <item name="android:fontFamily">@font/urbanist_bold</item>
    </style>

</resources>
